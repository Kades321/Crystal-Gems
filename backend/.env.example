# Database (Supabase PostgreSQL)
# Get your connection string from: Supabase Dashboard > Settings > Database > Connection string > URI
DATABASE_URL=postgresql://postgres.xxxx:yourpassword@aws-0-region.pooler.supabase.com:6543/postgres

# Auth settings
JWT_SECRET_KEY=replace_this_with_a_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Default admin bootstrap credentials (change after first login)
ADMIN_EMAIL=admin@crystalgems.local
ADMIN_PASSWORD=admin123

# SMTP Settings (required for contact form emails)
# For Gmail: use smtp.gmail.com and an App Password (https://myaccount.google.com/apppasswords)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here

# The email address where contact inquiries will be sent
BUSINESS_EMAIL=your_business_email@gmail.com
